{
  "name": "Sombreado de Programas - Piscina",
  "short_name": "Sombreado",
  "description": "Sombrea programas de natación en PDF con las reglas del script de Colab.",
  "lang": "es-PE",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0b3d5c",
  "theme_color": "#0b3d5c",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "pdf", "accept": ["application/pdf", ".pdf"] }]
    }
  }
}
